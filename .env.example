# ============================================================
# GSM Brothers AI Recovery Calling Agent — environment config
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Runtime mode (see README "Test mode" / "Dry-run mode") ---
# TEST_MODE: when true, only TEST_PHONE_NUMBER may ever be dialed.
TEST_MODE=true
# DRY_RUN: when true, no telephony call is ever placed; the full
# pipeline (queue -> schedule -> "call" -> sheet/DB update) is simulated.
DRY_RUN=true

# --- Timezone ---
TIMEZONE=Asia/Karachi

# --- Google Sheets ---
# Either set GOOGLE_SERVICE_ACCOUNT_JSON to the raw JSON string of the
# service account key, or GOOGLE_SERVICE_ACCOUNT_FILE to a path to the
# JSON key file. GOOGLE_SERVICE_ACCOUNT_JSON takes precedence if both set.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SPREADSHEET_ID=
GOOGLE_WORKSHEET_NAME=Consumers

# --- Telephony provider ---
# Supported: twilio (telnyx reserved for future implementation)
TELEPHONY_PROVIDER=twilio

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public base URL Twilio can reach for webhooks/media streams, e.g. via ngrok
# in dev or your real domain in production. No trailing slash.
PUBLIC_BASE_URL=

# --- AI / LLM provider (conversation NLU: intent + language classification only) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Fallback providers: if the primary Anthropic call fails (outage, rate
# limit, zero credit balance), conversation_engine tries the next configured
# provider in LLM_FALLBACK_ORDER before degrading to offline keyword
# matching. A provider is only tried if its API key below is set -- leave
# either blank to skip it.
LLM_FALLBACK_ORDER=anthropic,deepseek,gemini,openrouter,openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
# gemini-2.0-flash can 429 with a 0-quota free tier depending on the key's
# project; gemini-flash-latest has tested working for both plain generation
# and function-calling.
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Speech (Google Cloud Speech-to-Text / Text-to-Speech) ---
# Uses the same GOOGLE_SERVICE_ACCOUNT_JSON/FILE credentials above if the
# service account has the Speech API roles; otherwise set separately:
GOOGLE_SPEECH_CREDENTIALS_JSON=
GOOGLE_SPEECH_CREDENTIALS_FILE=

# --- Call recording ---
CALL_RECORDING_ENABLED=false

# --- Retry / concurrency ---
MAX_CALL_RETRIES=3
MAX_CONCURRENT_CALLS=1

# --- Daily calling schedule (24h HH:MM, in TIMEZONE) ---
CALL_START_1=09:20
CALL_END_1=12:45

CALL_START_2=14:20
CALL_END_2=17:20

CALL_START_3=17:45
CALL_END_3=18:30

# --- Database ---
# SQLite by default; swap for a PostgreSQL URL in production, e.g.:
# postgresql+psycopg2://user:password@host:5432/gsm_recovery
DATABASE_URL=sqlite:///./data/gsm_recovery.db

# --- Test mode fixtures ---
TEST_PHONE_NUMBER=+923000000000
TEST_CONSUMER_NAME=Test Consumer
TEST_OUTSTANDING_AMOUNT=5000
TEST_DUE_DATE=2026-08-15
TEST_SCHEME=3 installments of Rs. 1667

# --- Dashboard / control API auth ---
# Shared secret the dashboard and the OpenClaw skill use to call the
# campaign control API (app/campaign_control.py).
CONTROL_API_TOKEN=

# --- App server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
